    {
      "type": "header",
      "content": "Toggle button"
    },
    {
      "type": "text",
      "id": "read_more_text",
      "label": "Read more text",
      "default": "Read more"
    },
    {
      "type": "text",
      "id": "read_less_text",
      "label": "Read less text",
      "default": "Read less"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#585b56"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#809b6f"
    }
