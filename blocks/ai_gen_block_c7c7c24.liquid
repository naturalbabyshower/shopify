{% doc %}
  @prompt
    Create a 3-column header bar section for the header area. Each column should support either a text message or an image (merchant can choose per column). Features should include: customisable background colour and text colour, option to show/hide each column, text alignment control per column, support for icons or small images alongside text, and full responsiveness (stacks or scrolls horizontally on mobile). Ideal use cases include trust signals, USPs, shipping info, or logo badges like Trustpilot. Allow each column to have its own link URL.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-header-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.vertical_padding }}px 0;
  }

  .ai-header-bar-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    align-items: center;
  }

  .ai-header-bar-column-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_text_gap }}px;
    min-width: 0;
  }

  .ai-header-bar-column-{{ ai_gen_id }}--left {
    justify-content: flex-start;
    text-align: left;
  }

  .ai-header-bar-column-{{ ai_gen_id }}--center {
    justify-content: center;
    text-align: center;
  }

  .ai-header-bar-column-{{ ai_gen_id }}--right {
    justify-content: flex-end;
    text-align: right;
  }

  .ai-header-bar-column-{{ ai_gen_id }}--hidden {
    display: none;
  }

  .ai-header-bar-link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_text_gap }}px;
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .ai-header-bar-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-header-bar-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: auto;
    object-fit: contain;
  }

  .ai-header-bar-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media screen and (max-width: 749px) {
    .ai-header-bar-container-{{ ai_gen_id }} {
      {% if block.settings.mobile_layout == 'stack' %}
        grid-template-columns: 1fr;
        gap: {{ block.settings.mobile_stack_gap }}px;
      {% elsif block.settings.mobile_layout == 'scroll' %}
        grid-template-columns: repeat(3, minmax(200px, 1fr));
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      {% else %}
        grid-template-columns: 1fr 1fr 1fr;
        gap: {{ block.settings.column_gap | divided_by: 2 }}px;
      {% endif %}
    }

    .ai-header-bar-container-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    {% if block.settings.mobile_layout == 'scroll' %}
      .ai-header-bar-column-{{ ai_gen_id }} {
        scroll-snap-align: start;
      }
    {% endif %}

    {% if block.settings.mobile_layout == 'stack' %}
      .ai-header-bar-column-{{ ai_gen_id }} {
        justify-content: center;
        text-align: center;
      }
    {% endif %}

    .ai-header-bar-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-header-bar-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size }}px;
      height: auto;
    }
        .ai-header-bar-column-{{ ai_gen_id }}--center {
      display: none;
    }
        .ai-header-bar-column-{{ ai_gen_id }}--right {
      display: none;
    }
  }
{% endstyle %}

<header-bar-{{ ai_gen_id }} class="ai-header-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-header-bar-container-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign show_key = 'show_column_' | append: i
        assign type_key = 'column_' | append: i | append: '_type'
        assign text_key = 'column_' | append: i | append: '_text'
        assign image_key = 'column_' | append: i | append: '_image'
        assign link_key = 'column_' | append: i | append: '_link'
        assign align_key = 'column_' | append: i | append: '_align'

        assign show_column = block.settings[show_key]
        assign column_type = block.settings[type_key]
        assign column_text = block.settings[text_key]
        assign column_image = block.settings[image_key]
        assign column_link = block.settings[link_key]
        assign column_align = block.settings[align_key]

        assign column_class = 'ai-header-bar-column-' | append: ai_gen_id | append: ' ai-header-bar-column-' | append: ai_gen_id | append: '--' | append: column_align
        
        if show_column == false
          assign column_class = column_class | append: ' ai-header-bar-column-' | append: ai_gen_id | append: '--hidden'
        endif
      %}

      <div class="{{ column_class }}">
        {% if show_column %}
          {% if column_link != blank %}
            <a href="{{ column_link }}" class="ai-header-bar-link-{{ ai_gen_id }}">
              {% if column_type == 'image' and column_image != blank %}
                <img
                  src="{{ column_image | image_url: width: 300 }}"
                  alt="{{ column_image.alt | escape }}"
                  class="ai-header-bar-icon-{{ ai_gen_id }}"
                  loading="lazy"
                  width="{{ block.settings.icon_size }}"
                  height="auto"
                >
              {% elsif column_type == 'text_with_icon' and column_image != blank %}
                <img
                  src="{{ column_image | image_url: width: 100 }}"
                  alt="{{ column_image.alt | escape }}"
                  class="ai-header-bar-icon-{{ ai_gen_id }}"
                  loading="lazy"
                  width="{{ block.settings.icon_size }}"
                  height="{{ block.settings.icon_size }}"
                >
              {% endif %}
              
              {% if column_type == 'text' or column_type == 'text_with_icon' %}
                {% if column_text != blank %}
                  <span class="ai-header-bar-text-{{ ai_gen_id }}">{{ column_text }}</span>
                {% endif %}
              {% endif %}
            </a>
          {% else %}
            {% if column_type == 'image' and column_image != blank %}
        
{% render 'trustpilot-inline',
  rating: 4.6,
  reviews: '23K+',
  label: 'Excellent'
%}

            {% elsif column_type == 'text_with_icon' and column_image != blank %}
              <img
                src="{{ column_image | image_url: width: 100 }}"
                alt="{{ column_image.alt | escape }}"
                class="ai-header-bar-icon-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ block.settings.icon_size }}"
                height="{{ block.settings.icon_size }}"
              >
            {% endif %}
            
            {% if column_type == 'text' or column_type == 'text_with_icon' %}
              {% if column_text != blank %}
                <span class="ai-header-bar-text-{{ ai_gen_id }}">{{ column_text }}</span>
              {% endif %}
            {% endif %}
          {% endif %}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</header-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class HeaderBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initScrollBehavior();
      }

      initScrollBehavior() {
        const container = this.querySelector('.ai-header-bar-container-{{ ai_gen_id }}');
        if (!container) return;

        const isMobile = window.matchMedia('(max-width: 749px)').matches;
        const isScrollLayout = container.style.overflowX === 'auto' || 
                              getComputedStyle(container).overflowX === 'auto';

        if (isMobile && isScrollLayout) {
          let isDown = false;
          let startX;
          let scrollLeft;

          container.addEventListener('mousedown', (e) => {
            isDown = true;
            startX = e.pageX - container.offsetLeft;
            scrollLeft = container.scrollLeft;
          });

          container.addEventListener('mouseleave', () => {
            isDown = false;
          });

          container.addEventListener('mouseup', () => {
            isDown = false;
          });

          container.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - container.offsetLeft;
            const walk = (x - startX) * 2;
            container.scrollLeft = scrollLeft - walk;
          });
        }
      }
    }

    customElements.define('header-bar-{{ ai_gen_id }}', HeaderBar{{ ai_gen_id }});
  })();
</script>

