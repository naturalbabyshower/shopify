{%- liquid
  assign product_state = product.metafields.custom.product_state
  assign product_discount = product.metafields.custom.product_discount
  assign product_discount_type = product.metafields.custom.product_discount_type
  assign product_discount_reason = product.metafields.custom.product_discount_reason
  assign availabilty_color = 'bg-matcha-green t-white'
  assign offer_color = 'bg-forest-green t-white'
  assign clearance_color = 'bg-coral-blush light75 t-white'
  assign outlet_color = 'bg-forest-green t-white'
  assign tag_color = 'bg-light-sage t-forest-green'
-%}
{%- if product.available -%}
  <div class="grid-product__tags">
  {%- if product_state == 'Coming Soon' -%}
    <div class="grid-product__tag {{ availabilty_color }}">
      {{ 'products.general.coming_soon' | t }}
    </div>
  {%- elsif product_state == 'Preorder' -%}
    <div class="grid-product__tag {{ availabilty_color }}">
      {{ 'products.general.preorder' | t }}
    </div>
  {%- elsif product_state == 'New In' -%}
    <div class="grid-product__tag {{ availabilty_color }}">
      {{ 'products.general.new' | t }}
    </div>
  {%- endif -%}
  {%- render 'product-grid-item-tags1',
    product: product,
    product_discount: product_discount,
    product_discount_type: product_discount_type,
    product_discount_reason: product_discount_reason,
    offer_color: offer_color,
    clearance_color: clearance_color,
    outlet_color: outlet_color,
    tag_color: tag_color
  -%}
   </div>
{%- endif -%}
