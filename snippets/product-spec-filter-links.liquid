{%- liquid
  assign filter_colour = product.metafields.custom.filter_colour.value
  assign mid_collection = product.metafields.custom.mid_category.value
-%}
{% if mid_collection contains 'Pushchairs' %}
  <ul>
    {% if filter_colour contains 'Black' %}
      {% assign filter_collection = collections['pushchairs-strollers-black'] %}
      <li>
        {{
          filter_collection.title
          | link_to: filter_collection.url, title: filter_collection.title, class: 'filter-colour'
        }}
      </li>
    {%- endif %}
