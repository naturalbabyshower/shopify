{%- liquid
  assign rating_value = product.metafields.yotpo.reviews_average
  assign review_count = product.metafields.yotpo.reviews_count
  assign review_count_num = review_count | times: 1.0
  assign meta_product_description = product.metafields.global.description_tag.value
-%}

"name": {{ product.title | json }},
"description": {{ meta_product_description | default: product.description | strip_html | strip_newlines | replace: '&nbsp;', ' '| truncate: 180 | json }},
"category": {{ product.category | json }},
"url": {{ canonical_url | json }},
"brand": {
  "@type": "Brand",
  "name": {{ product.vendor | json }}
},
{% if review_count_num > 0 -%}
"aggregateRating": {
  "@type": "AggregateRating",
  "ratingValue": "{{ rating_value }}",
  "reviewCount": "{{ review_count }}"
},
{% endif -%}
{% if product.images.size > 0 -%}
"image": [
  {% for image in product.images limit: 5 -%}
    {{ image | image_url: width: 1200 | prepend: "https:" | json }}{% unless forloop.last %},{% endunless %}
  {% endfor -%}
],
{% endif -%}