{% comment %}
  Brand site switcher tabs above the toolbar.
{% endcomment %}
{%- liquid
  assign host = request.host | downcase
  assign nbs_current = false
  if host contains 'naturalbabyshower'
    assign nbs_current = true
  endif
-%}

{% style %}
  .brand-tabs {
    display: flex;
    width: 100%;
  }
  .brand-tabs__tab {
    align-items: center;
    display: flex;
    flex: 1 1 0;
    height: 28px;
    justify-content: center;
    min-width: 0;
    padding: 4px 8px;
    text-decoration: none;
  }
  .brand-tabs__tab--nbs {
    background-color: #f9f8f5;
    border-radius: 8px 8px 0 0;
  }
  .brand-tabs__tab--merino {
    background-color: #dcd4c9;
    border-radius: 8px 8px 0 0;
  }
  .brand-tabs__tab--babiators {
    background-color: #2e61ae;
    border-radius: 8px 8px 0 0;
  }
  .brand-tabs__logo {
    display: block;
    height: 14px;
    max-width: 92%;
    object-fit: contain;
    object-position: center;
    width: auto;
  }
  .brand-tabs__tab:hover {
    opacity: 0.92;
  }
  .brand-tabs__tab:focus-visible {
    outline: 2px solid var(--color-charcoal-grey, #585b56);
    outline-offset: -2px;
  }
  @media only screen and (min-width: 769px) {
    .brand-tabs {
      width: 33.333%;
    }
    .brand-tabs__tab {
      height: 32px;
      padding: 4px 12px;
    }
    .brand-tabs__logo {
      height: 16px;
    }
  }
{% endstyle %}

<nav class="brand-tabs" aria-label="Brand websites">
  <a
    class="brand-tabs__tab brand-tabs__tab--nbs{% if nbs_current %} is-current{% endif %}"
    href="{% if nbs_current %}/{% else %}https://www.naturalbabyshower.co.uk/{% endif %}"
    {% if nbs_current %}aria-current="page"{% endif %}
  >
    <img
      class="brand-tabs__logo"
      src="{{ 'brand-tab-nbs.png' | asset_url }}"
      alt="Natural Baby Shower"
      width="157"
      height="16"
    >
  </a>
  <a
    class="brand-tabs__tab brand-tabs__tab--merino{% if host contains 'merinokids' %} is-current{% endif %}"
    href="https://merinokids.co.uk/"
    target="_blank"
    rel="noopener noreferrer"
    {% if host contains 'merinokids' %}aria-current="page"{% endif %}
  >
    <img
      class="brand-tabs__logo"
      src="{{ 'brand-tab-merino.png' | asset_url }}"
      alt="Merino Kids"
      width="120"
      height="16"
    >
  </a>
  <a
    class="brand-tabs__tab brand-tabs__tab--babiators{% if host contains 'babiators' %} is-current{% endif %}"
    href="https://babiators-uk.com/"
    target="_blank"
    rel="noopener noreferrer"
    {% if host contains 'babiators' %}aria-current="page"{% endif %}
  >
    <img
      class="brand-tabs__logo"
      src="{{ 'brand-tab-babiators.png' | asset_url }}"
      alt="Babiators"
      width="114"
      height="16"
    >
  </a>
</nav>
