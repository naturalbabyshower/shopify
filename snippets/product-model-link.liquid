{%- liquid
  assign model_title = ''
  assign model_url = ''
  assign model_handle = ''
  assign model_mf = product.metafields.custom.model_collection
  assign model_value = model_mf.value

  if model_mf.type contains 'list'
    for list_col in model_value
      if list_col.title != blank
        assign model_title = list_col.title
        assign model_url = list_col.url
        assign model_handle = list_col.handle
        break
      endif
    endfor
  elsif model_value.collection.value != blank
    assign model_title = model_value.collection.value.title
    assign model_url = model_value.collection.value.url
    assign model_handle = model_value.collection.value.handle
  elsif model_value.title != blank
    assign model_title = model_value.title
    assign model_url = model_value.url
    assign model_handle = model_value.handle
  elsif model_value contains 'gid://shopify/Collection/'
    assign gid_id = model_value | split: '/' | last | plus: 0
    for col in product.collections
      if col.id == gid_id
        assign model_title = col.title
        assign model_url = col.url
        assign model_handle = col.handle
        break
      endif
    endfor
  elsif model_value != blank
    assign model_handle = model_value | handleize
  endif

  if model_handle != blank
    if model_title == blank
      assign model_title = collections[model_handle].title
    endif
    if model_url == blank
      assign model_url = collections[model_handle].url
    endif
    if model_url == blank
      assign model_url = routes.collections_url | append: '/' | append: model_handle
    endif
  endif

  if model_title == blank or model_url == blank
    for col in product.collections
      assign col_level = col.metafields.custom.collection_level.value | default: col.metafields.custom.collection_level | downcase
      if col_level == 'model' or col_level == 'range'
        assign model_title = col.title
        assign model_url = col.url
        break
      endif
    endfor
  endif
-%}

{%- if model_title != blank and model_url != blank -%}
  <a
    class="product-model-link"
    href="{{ model_url }}"
    title="View {{ model_title | escape }}"
  >
    View {{ model_title }}
  </a>
{%- endif -%}
