{% comment %}
  Product Inventory Snippet
  - This snippet is used to display the inventory of a product
  - This includes two key items (1) the inventory quantity and (2) the inventory transfer notice

  Parameters:
  - product: The product object
  - current_variant: The current variant object
  - block: The block object

  Usage:
  {% include 'product-inventory' with product: product, current_variant: current_variant, block: block %}
{% endcomment %}

{%- liquid
  assign instock = false
  assign oos = false
  assign due_date = false
  assign lead = false
  assign lead_date = false
  assign oos_and_continue_selling = false
  assign show_low_inventory_message = false
  assign stock_text = false
  assign ship_text = false
  assign shipping_date = false
  assign oversell_standard = false
  assign oversell_bundle = false
  assign oversell_dropship = false
  assign product_state = product.metafields.custom.product_state.value
  assign oversell_reason = current_variant.metafields.custom.oversell_reason.value
  assign inventory_policy = current_variant.inventory_policy
  assign due_date = current_variant.metafields.custom.due_date.value | date: '%b %e'
  assign lead = current_variant.metafields.custom.oversell_lead
  assign template_suffix = product.template_suffix

  if current_variant.inventory_management == 'shopify'
    if current_variant.inventory_quantity <= block.settings.inventory_threshold and current_variant.inventory_quantity > 0
      # If inventory is low, show the low inventory message
      assign show_low_inventory_message = true
    endif
    if current_variant.inventory_quantity > 4 and template_suffix != 'bundle-infinite'
      assign instock = true
      assign stock_text = 'products.product.in_stock' | t
      assign ship_text = '&nbsp;|&nbsp;Get it by&nbsp;'
    elsif current_variant.inventory_quantity > 0 and template_suffix != 'bundle-infinite'
      assign instock = true
      assign stock_text = 'products.product.stock_label' | t: count: current_variant.inventory_quantity
      assign ship_text = '&nbsp;|&nbsp;Get it by&nbsp;'
    elsif current_variant.inventory_quantity <= 0 and inventory_policy == 'continue' and template_suffix != 'bundle-infinite'
      assign oos_and_continue_selling = true
      if oversell_reason == 'Standard'
        assign oversell_standard = true
        assign stock_text = 'products.product.stock_incoming' | t
        assign ship_text = '&nbsp;|&nbsp;Ship by&nbsp;'
      elsif oversell_reason == 'Bundle Only'
        assign oversell_bundle = true
        assign stock_text = 'Available in Bundles'
        assign ship_text = '&nbsp;|&nbsp;Back soon&nbsp;'
      elsif oversell_reason == 'Dropship'
        assign oversell_dropship = true
        assign stock_text = 'products.product.direct' | t
        assign ship_text = '&nbsp;|&nbsp;Ship in&nbsp;'
      endif
    elsif current_variant.inventory_quantity > 0 and template_suffix == 'bundle-infinite' and inventory_policy == 'deny'
      assign instock = true
      assign stock_text = 'products.product.in_stock' | t
      assign ship_text = '&nbsp;|&nbsp;Get it by&nbsp;'
    elsif current_variant.inventory_quantity > 0 and template_suffix == 'bundle-infinite' and inventory_policy == 'continue'
      assign oos_and_continue_selling = true
      assign oversell_standard = true
      assign stock_text = 'products.product.stock_incoming' | t
      assign ship_text = '&nbsp;|&nbsp;Ship by&nbsp;'
    elsif current_variant.inventory_quantity <= 0 and inventory_policy == 'deny'
      if product_state == 'Discontinued'
        assign oos = true
        assign stock_text = 'products.product.sold_out' | t
        assign ship_text = '&nbsp;|&nbsp;Product discontinued&nbsp;'
      else
        assign oos = true
        assign stock_text = 'products.product.out_of_stock' | t
        assign ship_text = '&nbsp;|&nbsp;Back soon&nbsp;'
      endif
    endif
  endif

  assign currentday = 'now' | date: '%a'
  assign currenttime = 'now' | date: '%H%M'
  assign currentday_s = 'now' | date: '%s'

  if currentday == 'Mon'
    if currenttime < '1600'
      assign seconds = 1 | times: 24 | times: 60 | times: 60
      assign next_delivery_day = currentday_s | plus: seconds
    elsif currenttime >= '1600'
      assign seconds = 2 | times: 24 | times: 60 | times: 60
      assign next_delivery_day = currentday_s | plus: seconds
    endif
  elsif currentday == 'Tue'
    if currenttime < '1600'
      assign seconds = 1 | times: 24 | times: 60 | times: 60
      assign next_delivery_day = currentday_s | plus: seconds
    elsif currenttime >= '1600'
      assign seconds = 2 | times: 24 | times: 60 | times: 60
      assign next_delivery_day = currentday_s | plus: seconds
    endif
  elsif currentday == 'Wed'
    if currenttime < '1600'
      assign seconds = 1 | times: 24 | times: 60 | times: 60
      assign next_delivery_day = currentday_s | plus: seconds
    elsif currenttime >= '1600'
      assign seconds = 2 | times: 24 | times: 60 | times: 60
      assign next_delivery_day = currentday_s | plus: seconds
    endif
  elsif currentday == 'Thu'
    if currenttime < '1600'
      assign seconds = 1 | times: 24 | times: 60 | times: 60
      assign next_delivery_day = currentday_s | plus: seconds
    elsif currenttime >= '1600'
      assign seconds = 2 | times: 24 | times: 60 | times: 60
      assign next_delivery_day = currentday_s | plus: seconds
    endif
  elsif currentday == 'Fri'
    if currenttime < '1600'
      assign seconds = 1 | times: 24 | times: 60 | times: 60
      assign next_delivery_day = currentday_s | plus: seconds
    elsif currenttime >= '1600'
      assign seconds = 2 | times: 24 | times: 60 | times: 60
      assign next_delivery_day = currentday_s | plus: seconds
    endif
  elsif currentday == 'Sat'
    if currenttime < '1200'
      assign seconds = 1 | times: 24 | times: 60 | times: 60
      assign next_delivery_day = currentday_s | plus: seconds
    elsif currenttime >= '1200'
      assign seconds = 3 | times: 24 | times: 60 | times: 60
      assign next_delivery_day = currentday_s | plus: seconds
    endif
  elsif currentday == 'Sun'
    assign seconds = 2 | times: 24 | times: 60 | times: 60
    assign next_delivery_day = currentday_s | plus: seconds
  endif

  assign next_delivery_date = next_delivery_day | date: '%a, %b %e'
  assign today = 'today' | date: '%s'

  case lead
    when '3-5 days'
      assign lead_date = false
    when '5-7 days'
      assign lead_date = false
    when '7-10 days'
      assign lead_date = false
    when '10-14 days'
      assign lead_date = false
    when '2 weeks'
      assign seconds = 14 | times: 24 | times: 60 | times: 60
      assign lead_date = today | date: '%s' | plus: seconds | date: '%b %e'
    when '3 weeks'
      assign seconds = 21 | times: 24 | times: 60 | times: 60
      assign lead_date = today | date: '%s' | plus: seconds | date: '%b %e'
    when '4 weeks'
      assign seconds = 28 | times: 24 | times: 60 | times: 60
      assign lead_date = today | date: '%s' | plus: seconds | date: '%b %e'
    when '5 weeks'
      assign seconds = 35 | times: 24 | times: 60 | times: 60
      assign lead_date = today | date: '%s' | plus: seconds | date: '%b %e'
    when '6 weeks'
      assign seconds = 42 | times: 24 | times: 60 | times: 60
      assign lead_date = today | date: '%s' | plus: seconds | date: '%b %e'
    when '7 weeks'
      assign seconds = 49 | times: 24 | times: 60 | times: 60
      assign lead_date = today | date: '%s' | plus: seconds | date: '%b %e'
    when '8 weeks'
      assign seconds = 56 | times: 24 | times: 60 | times: 60
      assign lead_date = today | date: '%s' | plus: seconds | date: '%b %e'
    when '9 weeks'
      assign seconds = 63 | times: 24 | times: 60 | times: 60
      assign lead_date = today | date: '%s' | plus: seconds | date: '%b %e'
    when '10 weeks'
      assign seconds = 70 | times: 24 | times: 60 | times: 60
      assign lead_date = today | date: '%s' | plus: seconds | date: '%b %e'
    else
      assign seconds = 30 | times: 24 | times: 60 | times: 60
      assign lead_date = today | date: '%s' | plus: seconds | date: '%b %e'
  endcase

  if instock
    assign shipping_date = next_delivery_date
    assign delivery_number = next_delivery_day | date: '%e'
  elsif oos_and_continue_selling
    if oversell_standard
      if due_date
        assign shipping_date = due_date
        assign delivery_number = due_date | date: '%e'
      elsif lead_date
        assign shipping_date = lead_date
        assign delivery_number = lead_date | date: '%e'
      elsif lead_date == false
        assign shipping_date = lead
        assign delivery_number = ''
      endif
    elsif oversell_bundle
      assign shipping_date = ''
      assign delivery_number = ''
    elsif oversell_dropship
      assign shipping_date = lead
      assign delivery_number = ''
    endif
  elsif oos
    assign shipping_date = ''
    assign delivery_number = ''
  endif

  if delivery_number == ' 1' or delivery_number == '21' or delivery_number == '31'
    assign ordinal = '<sup>st</sup>'
  elsif delivery_number == ' 2' or delivery_number == '22'
    assign ordinal = '<sup>nd</sup>'
  elsif delivery_number == ' 3' or delivery_number == '23'
    assign ordinal = '<sup>rd</sup>'
  elsif delivery_number == ''
    assign ordinal = ''
  else
    assign ordinal = '<sup>th</sup>'
  endif
-%}

<div class="product-block product-block--sales-point" {{ block.shopify_attributes }}>
  <ul class="sales-points">
    <li
      class="sales-point"
    >
      <span class="icon-and-text {% if show_low_inventory_message == true %}inventory--low{% elsif oversell_dropship %}inventory--dropship{% elsif oversell_standard %}inventory--oversell{% elsif oos or oversell_bundle %}inventory--sold-out{% endif %}">
        <span class="icon icon--inventory"></span>
        <b
          ><span id="stock_text">{{ stock_text }}</span></b
        >
        <span id="ship_text">{{ ship_text }}</span>
        <b
          ><span id="shipping_date">
            {{- shipping_date -}}
            {{- ordinal -}}
          </span></b
        >
      </span>
    </li>
  </ul>
</div>
<script>
        var quantity = {};
        var policy = {};
        var oversell_reason = {};
        var shipping_date = {};
        var stock_text = {};
        var ship_text = {};
        var icon = {};
          {% for variant in product.variants %}
            {%- liquid
              assign lead_date = false
              assign today = 'today' | date: '%s'
              assign due_date = variant.metafields.custom.due_date.value | date: '%b %e'
              assign lead = variant.metafields.custom.oversell_lead
              case lead
                when '3-5 days'
                  assign lead_date = false
                when '5-7 days'
                  assign lead_date = false
                when '7-10 days'
                  assign lead_date = false
                when '10-14 days'
                  assign lead_date = false
                when '2 weeks'
                  assign seconds = 14 | times: 24 | times: 60 | times: 60
                  assign lead_date = today | date: '%s' | plus: seconds | date: '%b %e'
                when '3 weeks'
                  assign seconds = 21 | times: 24 | times: 60 | times: 60
                  assign lead_date = today | date: '%s' | plus: seconds | date: '%b %e'
                when '4 weeks'
                  assign seconds = 28 | times: 24 | times: 60 | times: 60
                  assign lead_date = today | date: '%s' | plus: seconds | date: '%b %e'
                when '5 weeks'
                  assign seconds = 35 | times: 24 | times: 60 | times: 60
                  assign lead_date = today | date: '%s' | plus: seconds | date: '%b %e'
                when '6 weeks'
                  assign seconds = 42 | times: 24 | times: 60 | times: 60
                  assign lead_date = today | date: '%s' | plus: seconds | date: '%b %e'
                when '7 weeks'
                  assign seconds = 49 | times: 24 | times: 60 | times: 60
                  assign lead_date = today | date: '%s' | plus: seconds | date: '%b %e'
                when '8 weeks'
                  assign seconds = 56 | times: 24 | times: 60 | times: 60
                  assign lead_date = today | date: '%s' | plus: seconds | date: '%b %e'
                when '9 weeks'
                  assign seconds = 63 | times: 24 | times: 60 | times: 60
                  assign lead_date = today | date: '%s' | plus: seconds | date: '%b %e'
                when '10 weeks'
                  assign seconds = 70 | times: 24 | times: 60 | times: 60
                  assign lead_date = today | date: '%s' | plus: seconds | date: '%b %e'
                else
                  assign seconds = 30 | times: 24 | times: 60 | times: 60
                  assign lead_date = today | date: '%s' | plus: seconds | date: '%b %e'
              endcase

              if due_date != blank
                assign lead_date = due_date
                assign delivery_number = due_date | date: '%e'
                assign ship_text = '&nbsp;|&nbsp;Ship by&nbsp;'
              elsif lead_date != blank
                assign delivery_number = lead_date | date: '%e'
                assign ship_text = '&nbsp;|&nbsp;Ship by&nbsp;'
              elsif lead_date == false
                assign lead_date = lead
                assign delivery_number = ''
                assign ship_text = '&nbsp;|&nbsp;Ship in&nbsp;'
              endif

              if delivery_number == ' 1' or delivery_number == '21' or delivery_number == '31'
                assign ordinal2 = '<sup>st</sup>'
              elsif delivery_number == ' 2' or delivery_number == '22'
                assign ordinal2 = '<sup>nd</sup>'
              elsif delivery_number == ' 3' or delivery_number == '23'
                assign ordinal2 = '<sup>rd</sup>'
              elsif delivery_number == ''
                assign ordinal2 = ''
              else
                assign ordinal2 = '<sup>th</sup>'
              endif
            -%}

      quantity[{{- variant.id -}}] = "{{ variant.inventory_quantity | default: 1 }}";
      policy[{{- variant.id -}}] = "{{ variant.inventory_policy }}";
      oversell_reason[{{- variant.id -}}] = "{{ variant.metafields.custom.oversell_reason.value }}";
    {%- if variant.inventory_quantity > 4 %}
      icon[{{- variant.id -}}] = '';
      stock_text[{{- variant.id -}}] = '{{ 'products.product.in_stock' | t }}';
      ship_text[{{- variant.id -}}] = '&nbsp;|&nbsp;Get it by&nbsp;';
      shipping_date[{{- variant.id -}}] = "{{ next_delivery_date }}{{- ordinal -}}";
    {%- elsif variant.inventory_quantity > 0 %}
      icon[{{- variant.id -}}] = ' inventory--low';
      stock_text[{{- variant.id -}}] = '{{ 'products.product.low_stock' | t }}';
      ship_text[{{- variant.id -}}] = '&nbsp;|&nbsp;Get it by&nbsp;';
      shipping_date[{{- variant.id -}}] = "{{ next_delivery_date }}{{- ordinal -}}";
    {%- elsif variant.inventory_quantity < 1 and variant.inventory_policy == 'continue' and variant.metafields.custom.oversell_reason.value == 'Standard' %}
      icon[{{- variant.id -}}] = ' inventory--oversell';
      stock_text[{{- variant.id -}}] = '{{ 'products.product.stock_incoming' | t }}';
      ship_text[{{- variant.id -}}] = "{{ ship_text }}";
      shipping_date[{{- variant.id -}}] = "{{ lead_date }}{{- ordinal2 -}}";
    {%- elsif variant.inventory_quantity < 1 and variant.inventory_policy == 'continue' and variant.metafields.custom.oversell_reason.value == 'Bundle Only' %}
      icon[{{- variant.id -}}] = ' inventory--sold-out';
      stock_text[{{- variant.id -}}] = 'Available in Bundles';
      ship_text[{{- variant.id -}}] = '&nbsp;|&nbsp;Back soon&nbsp;';
      shipping_date[{{- variant.id -}}] = '';
    {%- elsif variant.inventory_quantity < 1 and variant.inventory_policy == 'continue' and variant.metafields.custom.oversell_reason.value == 'Dropship' %}
      icon[{{- variant.id -}}] = ' inventory--dropship';
      stock_text[{{- variant.id -}}] = '{{ 'products.product.direct' | t }}';
      ship_text[{{- variant.id -}}] = '&nbsp;|&nbsp;Ship in&nbsp;';
      shipping_date[{{- variant.id -}}] = "{{ lead }}";
    {%- elsif variant.inventory_quantity < 1 and variant.inventory_policy == 'deny' and product.metafields.custom.product_state.value == 'Discontinued' %}
      icon[{{- variant.id -}}] = ' inventory--sold-out';
      stock_text[{{- variant.id -}}] = '{{ 'products.product.sold_out' | t }}';
      ship_text[{{- variant.id -}}] = '&nbsp;|&nbsp;Product discontinued&nbsp;';
      shipping_date[{{- variant.id -}}] = '';
    {%- elsif variant.inventory_quantity < 1 and variant.inventory_policy == 'deny' %}
      icon[{{- variant.id -}}] = ' inventory--sold-out';
      stock_text[{{- variant.id -}}] = '{{ 'products.product.out_of_stock' | t }}';
      ship_text[{{- variant.id -}}] = '&nbsp;|&nbsp;Back soon&nbsp;';
      shipping_date[{{- variant.id -}}] = '';
    {%- endif -%}
  {% endfor %}
      document.addEventListener('variant:change', function (evt) {
      console.log(evt.detail.variant);
        $(".icon-and-text").removeClass().addClass('icon-and-text');
        $(".icon-and-text").addClass(icon[evt.detail.variant.id]);
        $("#stock_text").html(stock_text[evt.detail.variant.id]);
        $("#ship_text").html(ship_text[evt.detail.variant.id]);
        $("#shipping_date").html(shipping_date[evt.detail.variant.id]);
      });
</script>

{%- assign variants_with_inventory_tracking = product.variants | where: 'inventory_management', 'shopify' -%}

<script>
    // Store inventory quantities in JS because they're no longer
    // available directly in JS when a variant changes.
    // Have an object that holds all potential products so it works
    // with quick view or with multiple featured products.
    window.inventories = window.inventories || {};
    window.inventories['{{ product.id }}'] = {};
  {%- for variant in variants_with_inventory_tracking %}
    window.inventories['{{ product.id }}'][{{ variant.id }}] = {
      'quantity': {{ variant.inventory_quantity | default: 0 }},
      'policy': '{{ variant.inventory_policy | default: false }}',
      'incoming': '{{ variant.incoming | default: false }}',
      'next_incoming_date': {{ variant.next_incoming_date | date: format: 'date' | json }}
    };
  {% endfor %}
</script>

{% comment %}
  If loaded in quick view, it might be from a JS-loaded function
  that loads recommended products. If that's the case, the above
  JS will not set the variant inventory. Add it to an accessible
  data div to read later instead.
{% endcomment %}
<div
  data-product-id="{{ product.id }}"
  class="hide js-product-inventory-data"
  aria-hidden="true"
>
  {%- for variant in variants_with_inventory_tracking -%}
    <div
      class="js-variant-inventory-data"
      data-id="{{ variant.id }}"
      data-quantity="{{ variant.inventory_quantity | default: 0 }}"
      data-policy="{{ variant.inventory_policy | default: false }}"
      data-incoming="{{ variant.incoming | default: false }}"
      data-date="{{ variant.next_incoming_date | date: format: 'date' }}"
    ></div>
  {%- endfor -%}
</div>
