{% comment %}
  Product Inventory Snippet
  - This snippet is used to display the inventory of a product
  - This includes two key items (1) the inventory quantity and (2) the inventory transfer notice

  Parameters:
  - product: The product object
  - current_variant: The current variant object
  - block: The block object

  Usage:
  {% render 'product-inventory-new', product: product, current_variant: current_variant, block: block %}
{% endcomment %}

{%- liquid
  assign instock = false
  assign oos = false
  assign due_date = false
  assign lead = false
  assign lead_date = false
  assign oos_and_continue_selling = false
  assign show_low_inventory_message = false
  assign stock_text = false
  assign ship_text = false
  assign shipping_date = false
  assign oversell_standard = false
  assign oversell_bundle = false
  assign oversell_dropship = false
  assign css_class = ''
  assign product_state = product.metafields.custom.product_state.value
  assign oversell_reason = current_variant.metafields.custom.oversell_reason.value
  assign inventory_policy = current_variant.inventory_policy
  assign due_date = current_variant.metafields.custom.due_date.value | date: '%b %e'
  assign lead = current_variant.metafields.custom.oversell_lead
  assign template_suffix = product.template_suffix

  if current_variant.inventory_management == 'shopify'
    if current_variant.inventory_quantity <= block.settings.inventory_threshold and current_variant.inventory_quantity > 0
      assign show_low_inventory_message = true
    endif
    if current_variant.inventory_quantity > 4 and template_suffix != 'bundle-infinite'
      assign instock = true
      assign stock_text = 'products.product.in_stock' | t
      assign ship_text = ' | Get it by '
    elsif current_variant.inventory_quantity > 0 and template_suffix != 'bundle-infinite'
      assign instock = true
      assign stock_text = 'products.product.stock_label' | t: count: current_variant.inventory_quantity
      assign ship_text = ' | Get it by '
    elsif current_variant.inventory_quantity <= 0 and inventory_policy == 'continue' and template_suffix != 'bundle-infinite'
      assign oos_and_continue_selling = true
      if oversell_reason == 'Standard'
        assign oversell_standard = true
        assign stock_text = 'products.product.stock_incoming' | t
        assign ship_text = ' | Ship by '
      elsif oversell_reason == 'Bundle Only'
        assign oversell_bundle = true
        assign stock_text = 'Available in Bundles'
        assign ship_text = ' | Back soon '
      elsif oversell_reason == 'Dropship'
        assign oversell_dropship = true
        assign stock_text = 'products.product.direct' | t
        assign ship_text = ' | Ship in '
      endif
    elsif current_variant.inventory_quantity > 0 and template_suffix == 'bundle-infinite' and inventory_policy == 'deny'
      assign instock = true
      assign stock_text = 'products.product.in_stock' | t
      assign ship_text = ' | Get it by '
    elsif current_variant.inventory_quantity > 0 and template_suffix == 'bundle-infinite' and inventory_policy == 'continue'
      assign oos_and_continue_selling = true
      assign oversell_standard = true
      assign stock_text = 'products.product.stock_incoming' | t
      assign ship_text = ' | Ship by '
    elsif current_variant.inventory_quantity <= 0 and inventory_policy == 'deny'
      if product_state == 'Discontinued'
        assign oos = true
        assign stock_text = 'products.product.sold_out' | t
        assign ship_text = ' | Product discontinued '
      else
        assign oos = true
        assign stock_text = 'products.product.out_of_stock' | t
        assign ship_text = ' | Back soon '
      endif
    endif
  endif

  assign currenttime = 'now' | date: '%H%M'
  assign currentday_s = 'now' | date: '%s'
  assign weekday = 'now' | date: '%w' | plus: 0

  if weekday == 0
    assign offset_days = 2
  elsif weekday == 6
    if currenttime < '1200'
      assign offset_days = 1
    elsif currenttime >= '1200'
      assign offset_days = 3
    endif
  elsif currenttime < '1600'
    assign offset_days = 1
  elsif currenttime >= '1600'
    assign offset_days = 2
  endif

  assign seconds = offset_days | times: 86400
  assign next_delivery_day = currentday_s | plus: seconds
  assign next_delivery_date = next_delivery_day | date: '%a, %b %e'
  assign today = 'today' | date: '%s'
  assign day_leads = '|3-5 days|5-7 days|7-10 days|10-14 days|'
  assign lead_token = '|' | append: lead | append: '|'

  if day_leads contains lead_token
    assign lead_date = false
  elsif lead contains 'weeks'
    assign weeks = lead | split: ' ' | first | plus: 0
    assign seconds = weeks | times: 7 | times: 86400
    assign lead_date = today | plus: seconds | date: '%b %e'
  else
    assign seconds = 30 | times: 86400
    assign lead_date = today | plus: seconds | date: '%b %e'
  endif

  if instock
    assign shipping_date = next_delivery_date
    assign delivery_number = next_delivery_day | date: '%e'
  elsif oos_and_continue_selling
    if oversell_standard
      if due_date
        assign shipping_date = due_date
        assign delivery_number = due_date | date: '%e'
      elsif lead_date
        assign shipping_date = lead_date
        assign delivery_number = lead_date | date: '%e'
      elsif lead_date == false
        assign shipping_date = lead
        assign delivery_number = ''
      endif
    elsif oversell_bundle
      assign shipping_date = ''
      assign delivery_number = ''
    elsif oversell_dropship
      assign shipping_date = lead
      assign delivery_number = ''
    endif
  elsif oos
    assign shipping_date = ''
    assign delivery_number = ''
  endif

  if delivery_number == ' 1' or delivery_number == '21' or delivery_number == '31'
    assign ordinal = '<sup>st</sup>'
  elsif delivery_number == ' 2' or delivery_number == '22'
    assign ordinal = '<sup>nd</sup>'
  elsif delivery_number == ' 3' or delivery_number == '23'
    assign ordinal = '<sup>rd</sup>'
  elsif delivery_number == ''
    assign ordinal = ''
  else
    assign ordinal = '<sup>th</sup>'
  endif

  if show_low_inventory_message
    assign css_class = 'inventory--low'
  elsif oversell_dropship
    assign css_class = 'inventory--dropship'
  elsif oversell_standard
    assign css_class = 'inventory--oversell'
  elsif oos or oversell_bundle
    assign css_class = 'inventory--sold-out'
  endif
-%}

<div class="product-block product-block--sales-point" {{ block.shopify_attributes }}>
  <ul class="sales-points">
    <li class="sales-point">
      <span class="icon-and-text {{ css_class }}">
        <span class="icon icon--inventory"></span><span class="sales-point__text"
          ><b><span id="stock_text">{{ stock_text }}</span></b
          ><span id="ship_text">{{ ship_text }}</span
          ><b
            ><span id="shipping_date"
              >{{- shipping_date -}}{{- ordinal -}}</span
            ></b
          ></span
        >
      </span>
    </li>
  </ul>
</div>

{%- render 'product-inventory-variant-data',
  product: product,
  next_delivery_date: next_delivery_date,
  ordinal: ordinal
-%}
