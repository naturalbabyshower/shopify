{% assign color_metaobject = product.metafields.custom.filter_colour.value -%}
"hasVariant": [
  {% for variant in product.variants -%}
  {% assign mpn = variant.metafields.mm-google-shopping.mpn.value -%}
  {
    "@type": "Product",
    "@id": {{ product.url | prepend: shop.url | append: "?variant=" | append: variant.id | append: "#product" | json }},
    "inProductGroupWithID": "{{ product.id }}",
    "name": {{ product.title | append: " - " | append: variant.title | json }},
    "description": {{ product.title | append: " - " | append: variant.title | default: product.description | strip_html | strip_newlines | replace: '&nbsp;', ' '| truncate: 180 | json }},
    "image": [ {%- if variant.image -%}{{ variant.image | image_url | prepend: "https:" | json }}{%- else -%}{{ product.featured_image | image_url | prepend: "https:" | json }}{%- endif -%}],
    "sku": {{ variant.sku | json }},
    {% if variant.barcode != blank and is_bundle != 'yes' -%}
    "gtin13": {{ variant.barcode | json }},
    {% endif -%}
    {% if mpn != blank -%}
    "mpn": {{ mpn | json }},
    {% endif -%}

    {%- assign color_value = '' -%}
    {%- assign size_value = '' -%}
    {%- for option in product.options -%}
      {%- assign opt_name = option | downcase -%}
      {%- assign index = forloop.index0 -%}
      {%- if opt_name contains 'color' or opt_name contains 'colour' -%}
        {%- assign color_value = variant.options[index] -%}
      {%- endif -%}
      {%- if opt_name contains 'size' -%}
        {%- assign size_value = variant.options[index] -%}
      {%- endif -%}
    {%- endfor -%}
    {% if color_value != blank -%}
    "color": {{ color_value | json }},
    {% elsif color_metaobject -%}
    "color": "{{ color_metaobject }}",
    {% endif %}
    {% if size_value != blank -%}
    "size": {{ size_value | json }},
    {% endif -%}
    {% assign option_names = product.options -%}
    {%- if option_names.size > 0 and color_value == blank and size_value == blank -%}
    "additionalProperty": [
      {%- for option in option_names -%}
        {%- assign index = forloop.index0 -%}
        {
          "@type": "PropertyValue",
          "name": {{- option | json -}},
          "value": {{- variant.options[index] | json -}}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    {%- endif -%}
    {% render 'schema-variant-offer', variant: variant, product: product %}
  }
  {% unless forloop.last -%},{% endunless -%}
  {% endfor -%}
]
