{%- liquid
  assign is_bundle = current_variant.metafields.custom.bundle | downcase | strip
  assign is_single_variant = false
  if product.has_only_default_variant or product.variants.size < 2
    assign is_single_variant = true
  endif
-%}
<script type="application/ld+json">
{
"@context": "https://schema.org",
{%- if is_single_variant -%}
"@type": "Product",
{%- else -%}
"@type": ["Product", "ProductGroup"],
{%- endif -%}
"@id": {{ product.url | prepend: shop.url | append: "#product" | json }},
{% render 'schema-core', product: product -%}
{% render 'schema-product-single', product: product -%}
{%- unless is_single_variant -%}
,
"productGroupID": "{{ product.id }}",
{% render 'schema-product-variants', product: product, is_bundle: is_bundle -%}
{%- endunless -%}
{% if is_bundle != blank -%}
  {%- assign vname = current_variant.title | downcase -%}
  {%- capture parts_json -%}
  {%- assign first = true -%}
  {%- if vname contains 'cot' or vname contains 'carrycot' -%}
    {%- unless first -%},{%- endunless -%}
    { "@type": "Product", "name": "Carrycot" }
    {%- assign first = false -%}
  {%- endif -%}
  {%- if vname contains 'bumper' -%}
    {%- unless first -%},{%- endunless -%}
    { "@type": "Product", "name": "Bumper Bar" }
    {%- assign first = false -%}
  {%- endif -%}
  {%- if vname contains 'car seat' or vname contains 'carseat' -%}
    {%- unless first -%},{%- endunless -%}
    { "@type": "Product", "name": "Car Seat" }
    {%- assign first = false -%}
  {%- endif -%}
  {%- endcapture -%}
  {%- if parts_json != blank -%}
  ,"hasPart": [
    { "@type": "Product", "name": {{ product.title | json }} },
    {{ parts_json }}
  ]
  {%- endif -%}
{% endif -%}
}
</script>
