{% comment %}
  Product descriptions often end with an empty <p>&nbsp;</p>, which leaves
  a blank line in the accordion because the real last paragraph is no
  longer :last-child and keeps its bottom margin.
{% endcomment %}
{%- liquid
  if product.empty?
    assign description = 'home_page.onboarding.product_description' | t
  else
    assign description = product.description
  endif
  assign description = description | replace: '<p>&nbsp;</p>', '' | replace: '<p> </p>', '' | replace: '<p></p>', '' | replace: '<p> </p>', '' | replace: '<p><br></p>', '' | replace: '<p><br/></p>', '' | replace: '<p><br /></p>', ''
-%}
{%- if is_tab -%}
  {% assign title = 'products.product.description' | t %}
  {%- render 'tab', id: id, title: title, content: description -%}
{%- else -%}
  <div class="rte">
    {{ description }}
  </div>
{%- endif -%}
