{%- comment -%}
  Parameters:
    id - unique id
    title - string
    content - string or markup
    force_open - boolean to set default state (currently unused, was only for Product Reviews tab)
{%- endcomment -%}
{%- liquid
  assign output_tab = true
  assign force_open = false
  if content == blank
    assign output_tab = false
  endif
  if title contains 'Highlights' or title contains 'Description' or title contains 'Outlet'
    assign force_open = true
  endif
  if title contains 'Technical'
    assign technical = true
  elsif title contains 'Delivery'
    assign delivery = true
    assign output_tab = true
  endif
-%}
{%- if output_tab -%}
  <div class="collapsibles-wrapper">
    <button
      type="button"
      class="label collapsible-trigger collapsible-trigger-btn collapsible-trigger-btn--borders collapsible--auto-height{% if force_open %} is-open{% endif %}"
      aria-controls="Product-content-{{ id }}"
      {% if force_open %}
        aria-expanded="true"
      {% endif %}
    >
      {{ title }}
      {%- render 'collapsible-icons' -%}
    </button>
    <div
      id="Product-content-{{ id }}"
      class="collapsible-content collapsible-content--all{% if force_open %} is-open{% endif %}"
      {% if force_open %}
        style="height: auto;"
      {% endif %}
    >
      <div class="collapsible-content__inner rte">
        {% if technical %}
          {%- render 'product-spec-data', product: product -%}
        {% elsif delivery %}
          {%- render 'product-tab-delivery', product: product, delivery_meta: delivery_meta -%}
        {% else %}
          {{ content }}
        {% endif %}
      </div>
    </div>
  </div>
{%- endif -%}
