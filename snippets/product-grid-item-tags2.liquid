{%- if product.available -%}
  {%- liquid
    assign parent_approved = product.metafields.custom.parent_approved
  -%}
  {%- if parent_approved -%}
    <div class="grid-product__tag {{ tag_color }}">{{ 'products.general.parent_tested' | t }}</div>
  {%- endif -%}
  {%- if product.tags contains 'limited-edition' -%}
    <div class="grid-product__tag {{ tag_color }}">{{ 'products.general.limited-edition' | t }}</div>
  {%- elsif product.tags contains 'special-edition' -%}
    <div class="grid-product__tag {{ tag_color }}">{{ 'products.general.special-edition' | t }}</div>
  {%- elsif product.tags contains 'exclusive-nbs' -%}
    <div class="grid-product__tag {{ tag_color }}">{{ 'products.general.exclusive-nbs' | t }}</div>
  {%- elsif product.tags contains 'exclusive-indie' -%}
    <div class="grid-product__tag {{ tag_color }}">{{ 'products.general.exclusive-indie' | t }}</div>
  {%- endif -%}
  {%- if product.tags contains 'carrycot-optional' -%}
    <div class="grid-product__tag {{ tag_color }}">{{ 'products.general.carrycot_option' | t }}</div>
  {%- elsif product.tags contains 'carrycot-included' -%}
    <div class="grid-product__tag {{ tag_color }}">{{ 'products.general.carrycot' | t }}</div>
  {%- endif -%}
  {%- if product.tags contains 'bumper-bar-included' -%}
    <div class="grid-product__tag {{ tag_color }}">{{ 'products.general.bumper_bar' | t }}</div>
  {%- endif -%}
  {%- if product.tags contains 'slidetech' -%}
    <div class="grid-product__tag {{ tag_color }}">{{ 'products.general.slidetech' | t }}</div>
  {%- elsif product.tags contains '360-rotation' -%}
    <div class="grid-product__tag {{ tag_color }}">{{ 'products.general.360-rotation' | t }}</div>
  {%- endif -%}
  {%- if product.tags contains 'arkid' -%}
    <div class="grid-product__tag {{ tag_color }}">
      3D & AR&nbsp;<svg xmlns="http://www.w3.org/2000/svg" style="position:relative; top:1px;" width="10" height="10" viewBox="0 0 512 512" aria-hidden="true" focusable="false"><polyline points="201.14 64 256 32 310.86 64" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"/><line x1="256" y1="32" x2="256" y2="112" fill="none" stroke="currentColor" stroke-linecap="round" stroke-miterlimit="10" stroke-width="32"/><polyline points="310.86 448 256 480 201.14 448" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"/><line x1="256" y1="480" x2="256" y2="400" fill="none" stroke="currentColor" stroke-linecap="round" stroke-miterlimit="10" stroke-width="32"/><polyline points="64 207.51 64 144 117.15 112.49" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"/><line x1="64" y1="144" x2="131.29" y2="184" fill="none" stroke="currentColor" stroke-linecap="round" stroke-miterlimit="10" stroke-width="32"/><polyline points="448 304.49 448 368 394.85 399.51" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"/><line x1="448" y1="368" x2="380.71" y2="328" fill="none" stroke="currentColor" stroke-linecap="round" stroke-miterlimit="10" stroke-width="32"/><polyline points="117.15 400 64 368 64 304.49" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"/><line x1="64" y1="368" x2="130.64" y2="328" fill="none" stroke="currentColor" stroke-linecap="round" stroke-miterlimit="10" stroke-width="32"/><polyline points="394.85 112.49 448 144 448 207.51" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"/><line x1="448" y1="144" x2="380.71" y2="184" fill="none" stroke="currentColor" stroke-linecap="round" stroke-miterlimit="10" stroke-width="32"/><polyline points="256 320 256 256 310.86 224" fill="none" stroke="currentColor" stroke-linecap="round" stroke-miterlimit="10" stroke-width="32"/><line x1="256" y1="256" x2="201.14" y2="224" fill="none" stroke="currentColor" stroke-linecap="round" stroke-miterlimit="10" stroke-width="32"/></svg>
    </div>
  {%- endif -%}
  {%- if product.tags contains 'universal-harness' -%}
    <div class="grid-product__tag {{ tag_color }}">Universal fit</div>
  {%- endif -%}
  {%- if template.name == 'product' -%}
    {%- assign tog = product.metafields.custom.tog_rating.value -%}
    {%- if tog contains '0-0.5 Tog' -%}
      <div class="grid-product__tag {{ tag_color }}">{{ 'products.general.summer-weight' | t }}</div>
    {%- elsif tog contains '1.0 Tog' or tog contains '1.5 Tog' -%}
      <div class="grid-product__tag {{ tag_color }}">{{ 'products.general.standard-weight' | t }}</div>
    {%- elsif tog contains '2.5 Tog' or tog contains '3.5 Tog' -%}
      <div class="grid-product__tag {{ tag_color }}">{{ 'products.general.winter-weight' | t }}</div>
    {%- endif -%}
    {%- if product.tags contains 'recycled' -%}
      <div class="grid-product__tag {{ tag_color }}">{{ 'products.general.recycled_plastic' | t }}</div>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
