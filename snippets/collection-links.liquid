{%- liquid
  assign offers = false
  assign offers_all = false
  assign offers_link = '?filter.p.m.custom.product_discount=Offer'
  assign collection_total = collection.all_products_count
  assign logo_link = collection.metafields.custom.collection_logos
  assign faq_link = collection.metafields.custom.collection_faqs
  assign articles_link = collection.metafields.custom.page_hero_columns
  assign buying_guides = collection.metafields.custom.buying_guides.value
  assign brand_spotlights = collection.metafields.custom.brand_spotlight.value
  assign external_symbol = '&nbsp;&nbsp;<svg style="position:relative; top:1px;" xmlns="http://www.w3.org/2000/svg" height="12" width="12" viewBox="0 0 512 512"><!--!Font Awesome Pro 6.5.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2024 Fonticons, Inc.--><path fill="#4C4C4C" d="M432 288H416a16 16 0 0 0 -16 16V458a6 6 0 0 1 -6 6H54a6 6 0 0 1 -6-6V118a6 6 0 0 1 6-6H208a16 16 0 0 0 16-16V80a16 16 0 0 0 -16-16H48A48 48 0 0 0 0 112V464a48 48 0 0 0 48 48H400a48 48 0 0 0 48-48V304A16 16 0 0 0 432 288zM500 0H364a12 12 0 0 0 -8.5 20.5l48.2 48.2L131.5 340.9a12 12 0 0 0 0 17l22.6 22.6a12 12 0 0 0 17 0l272.2-272.2 48.2 48.2A12 12 0 0 0 512 148V12A12 12 0 0 0 500 0z"/></svg>'
  assign scroll_symbol = '&nbsp;&nbsp;<svg style="position:relative; top:2px;" xmlns="http://www.w3.org/2000/svg" height="14" width="12.25" viewBox="0 0 448 512"><!--!Font Awesome Free 6.5.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.--><path fill="#4C4C4C" d="M188.8 512c45.6 0 83.2-37.8 83.2-83.2v-35.6a93.1 93.1 0 0 0 22.1-7.9c22 2.5 45-3.5 62.8-16C409.3 368.1 448 331.8 448 269.3V248c0-60.1-40-98.5-40-127.2v-2.7c5-5.7 8-13.5 8-22.1V32c0-17.7-12.9-32-28.8-32H156.8C140.9 0 128 14.3 128 32v64c0 8.6 3 16.4 8 22.1v2.7c0 7-6.2 14.9-23.7 30.2l-.1 .1-.1 .1c-9.9 8.9-20.8 18.1-33.3 25.9C48.5 195.8 0 207.5 0 252.8c0 56.9 35.3 92 83.2 92 8 0 15.5-.8 22.4-2.2V428.8c0 45.1 38.1 83.2 83.2 83.2zm0-48c-18.7 0-35.2-16.8-35.2-35.2V270.4c-17.3 0-35.2 26.4-70.4 26.4-26.4 0-35.2-20.6-35.2-44 0-8.8 32.7-20.4 56.1-34.9 14.6-9.1 27.2-19.5 39.9-30.8 18.4-16.1 36.6-33.8 39.6-59.1h176.8C364.1 170.8 400 202.5 400 248v21.3c0 40.5-22.2 57.1-61.3 50.6-8 14.6-34 24.2-53.6 12.9-18.2 19.4-46.4 17.8-61.1 5V428.8c0 19-16.2 35.2-35.2 35.2zM328 64c0-13.3 10.7-24 24-24s24 10.7 24 24-10.7 24-24 24-24-10.7-24-24z"/></svg>'
  assign offers_symbol = '&nbsp;&nbsp;<svg style="position:relative; top:2px;" xmlns="http://www.w3.org/2000/svg" height="14" width="12.25" viewBox="0 0 448 512"><!--!Font Awesome Pro 6.5.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2024 Fonticons, Inc.--><path fill="#4C4C4C" d="M0 96C0 78.3 14.3 64 32 64H416c17.7 0 32 14.3 32 32s-14.3 32-32 32H32C14.3 128 0 113.7 0 96zM64 256c0-17.7 14.3-32 32-32H352c17.7 0 32 14.3 32 32s-14.3 32-32 32H96c-17.7 0-32-14.3-32-32zM288 416c0 17.7-14.3 32-32 32H192c-17.7 0-32-14.3-32-32s14.3-32 32-32h64c17.7 0 32 14.3 32 32z"/></svg>'
  for product in collection.products
    if product.metafields.custom.product_discount == 'Offer'
      assign offers = true
    endif
  endfor
  for filter in collection.filters
    for filter_value in filter.active_values
      if filter_value.value == 'Offer'
        assign offers_all = true
        assign filter_remove = filter_value.url_to_remove
      endif
    endfor
  endfor
-%}
{% if offers or logo_link or faq_link or articles_link or collection_total > 10 %}
  <div class="collectionlinks">
    <nav class="collection-links" role="navigation" aria-label="collection-links">
      {% if offers_all %}
        <a
          href="{{ filter_remove }}"
          title
          >Show All{{ offers_symbol -}}
        </a>
      {% elsif offers %}
        <a
          href="{{ offers_link }}"
          title
          >Offers{{ offers_symbol -}}
        </a>
      {% endif %}
      {% if collection_total > 10 %}
        <a onclick="toppicks()">Top Picks{{ scroll_symbol }}</a>
      {% endif %}
      {% if logo_link %}
        <a onclick="logo()">Brands{{ scroll_symbol }}</a>
      {% endif %}
      {% if faq_link %}
        <a onclick="faqs()">FAQs{{ scroll_symbol }}</a>
      {% endif %}
      {% if articles_link %}
        <a onclick="articles()">Articles{{ scroll_symbol }}</a>
      {% endif %}
      {% for buying_guide in buying_guides %}
        {{- buying_guide.alias | append: external_symbol | link_to: buying_guide.url, target: buying_guide.target -}}
      {%- endfor -%}
      {% for brand_spotlight in brand_spotlights %}
        {{-
          brand_spotlight.alias
          | append: external_symbol
          | link_to: brand_spotlight.url, target: brand_spotlight.target
        -}}
      {%- endfor -%}
    </nav>
  </div>

  <script>
    function toppicks() {
      const element = document.getElementById("section-top-picks");
      element.scrollIntoView({
          behavior: 'smooth'
      });
    }
    function logo() {
      const element = document.getElementById("section-logo");
      element.scrollIntoView({
          behavior: 'smooth'
      });
    }
    function faqs() {
      const element = document.getElementById("section-faqs");
      element.scrollIntoView({
          behavior: 'smooth'
      });
    }
      function articles() {
      const element = document.getElementById("section-articles");
      element.scrollIntoView({
          behavior: 'smooth'
      });
    }
  </script>
  <style>
    .section-top-picks, .section-logo, .section-faqs, .section-articles { scroll-margin-top: 100px; }
  </style>
{% endif %}
