{%- liquid
  assign car_seat_age = product.metafields.custom.car_seat_age
-%}
{%- if car_seat_age != blank -%}
  {%- assign car_seat_direction = product.metafields.custom.car_option_3 -%}
  <div class="listing-extra-details">
    {{ car_seat_age }}
    {%- if car_seat_direction != blank %} | {{ car_seat_direction }}{% endif -%}
  </div>
{%- else -%}
  {%- assign stroller_model = product.metafields.custom.stroller_model -%}
  {%- if stroller_model != blank -%}
    {%- liquid
      assign stroller_mode = product.metafields.custom.stroller_mode.value
      assign stroller_subtype = product.metafields.custom.stroller_subtype.value
      if stroller_subtype contains 'Terrain'
        assign stroller_subtype = 'All Terrain'
      elsif stroller_subtype contains 'City'
        assign stroller_subtype = 'City/Urban'
      elsif stroller_subtype contains 'Compact'
        assign stroller_subtype = 'Compact/Travel'
      endif
    -%}
    <div class="listing-extra-details">
      {{ stroller_subtype -}}
      {%- if stroller_mode != blank %} | {{ stroller_mode }} mode{% endif -%}
    </div>
  {%- endif -%}
{%- endif -%}
