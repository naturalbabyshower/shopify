{%- liquid
  if block.settings.title == blank
    assign menu_title = linklists[block.settings.menu].title
  else
    assign menu_title = block.settings.title
  endif
  assign menu_id = 'FooterMenu-' | append: block.id
-%}

<div class="footer__menu-block">
  <h2 class="footer__title footer__title--desktop small--hide">
    {{ menu_title }}
  </h2>

  <button
    type="button"
    class="footer__menu-trigger collapsible-trigger collapsible-trigger-btn collapsible-trigger-btn--borders collapsible--auto-height medium-up--hide"
    aria-expanded="false"
    data-controls="{{ menu_id }}"
  >
    <span class="collapsible-trigger__layout">
      <span>{{ menu_title }}</span>
      {%- render 'collapsible-icons' -%}
    </span>
  </button>

  {%- comment -%}
    Do not use collapsible-content--all: theme.css and next.css set height:0
    at every breakpoint, which hid page-footer links. Collapse only via CSS
    inside the mobile nav clone. Match FAQ: auto-height on the trigger only.
    Use data-id (not HTML id) because the footer is cloned into the drawer.
  {%- endcomment -%}
  <div data-id="{{ menu_id }}" class="collapsible-content footer__menu-accordion">
    <div class="collapsible-content__inner">
      <ul class="footer__menu">
        {%- for link in linklists[block.settings.menu].links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
        {%- if block.settings.enable_account_link -%}
          <li><a href="{{ routes.account_url }}">{{ 'customer.account.title' | t }}</a></li>
        {%- endif -%}
      </ul>
    </div>
  </div>
</div>
