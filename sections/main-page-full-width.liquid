<div class="page-full page-content">
  {%- liquid
    assign section_nbs = true
    if page.title == 'Rewards Program'
      assign section_nbs = false
    endif
  -%}
  {%- if section_nbs -%}
    <header class="section-header">
      <h1 class="section-header__title">
        {{ page.title | escape }}
      </h1>
    </header>
  {%- endif -%}
  <div class="rte rte--nomargin">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-page-full-width.name",
  "tag": "section"
}
{% endschema %}
