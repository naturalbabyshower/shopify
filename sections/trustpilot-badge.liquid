{% liquid
  assign rating = section.settings.rating | plus: 0.0
  assign reviews = section.settings.review_count
  assign brand = section.settings.brand_name
  assign label = section.settings.label

  assign full_stars = rating | floor
  assign remainder = rating | minus: full_stars

  assign half_star = false
  if remainder >= 0.25 and remainder < 0.75
    assign half_star = true
  endif

  assign empty_stars = 5 | minus: full_stars
  if half_star
    assign empty_stars = empty_stars | minus: 1
  endif
%}

<section
  class="trustpilot-inline"
  itemscope
  itemtype="https://schema.org/AggregateRating"
>
  <meta itemprop="ratingValue" content="{{ rating }}">
  <meta itemprop="reviewCount" content="{{ reviews | replace: ',', '' }}">
  <meta itemprop="bestRating" content="5">
  <meta itemprop="worstRating" content="1">

  <!-- Stars -->
  <span class="tp-stars" aria-hidden="true">
    <svg
      width="92"
      height="16"
      viewBox="0 0 92 16"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
    >
      <defs>
        <symbol id="tp-star-full" viewBox="0 0 24 24">
          <path fill="#00B67A" d="M12 0l3 8h9l-7 5 3 11-8-6-8 6 3-11-7-5h9z"/>
        </symbol>

        <symbol id="tp-star-empty" viewBox="0 0 24 24">
          <path fill="#DCDCE6" d="M12 0l3 8h9l-7 5 3 11-8-6-8 6 3-11-7-5h9z"/>
        </symbol>

        <symbol id="tp-star-half" viewBox="0 0 24 24">
          <defs>
            <linearGradient id="tp-half-grad">
              <stop offset="50%" stop-color="#00B67A"/>
              <stop offset="50%" stop-color="#DCDCE6"/>
            </linearGradient>
          </defs>
          <path fill="url(#tp-half-grad)" d="M12 0l3 8h9l-7 5 3 11-8-6-8 6 3-11-7-5h9z"/>
        </symbol>
      </defs>

      {% assign x = 0 %}
      {% for i in (1..full_stars) %}
        <use href="#tp-star-full" x="{{ x }}" y="0" width="16" height="16" />
        {% assign x = x | plus: 18 %}
      {% endfor %}

      {% if half_star %}
        <use href="#tp-star-half" x="{{ x }}" y="0" width="16" height="16" />
        {% assign x = x | plus: 18 %}
      {% endif %}

      {% for i in (1..empty_stars) %}
        <use href="#tp-star-empty" x="{{ x }}" y="0" width="16" height="16" />
        {% assign x = x | plus: 18 %}
      {% endfor %}
    </svg>
  </span>

  <!-- Text -->
  <span class="tp-text">
    <strong class="tp-label">{{ label }}</strong>
    <span class="tp-rating">{{ rating }}</span>
    <span class="tp-sep">|</span>
    <span class="tp-reviews">Based on {{ reviews }} reviews</span>
    <span class="tp-sep">·</span>
    <span class="tp-brand">{{ brand }}</span>
  </span>
</section>

<style>
.trustpilot-inline {
  display: flex;
  align-items: center;
  gap: 8px; /* matches original image spacing */
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
  font-size: 14px;
  line-height: 1;
  color: #191919;
  padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  white-space: nowrap;
}

.tp-stars {
  display: inline-flex;
  align-items: center;
}

.tp-text {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.tp-label {
  font-weight: 600;
}

.tp-rating {
  font-weight: 500;
}

.tp-sep {
  color: #6B6B6B;
}

.tp-brand {
  color: #6B6B6B;
}

@media (max-width: 640px) {
  .trustpilot-inline {
    flex-wrap: wrap;
    white-space: normal;
  }
}
</style>

{% schema %}
{
  "name": "Trustpilot Badge",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Trustpilot"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Rating label",
      "default": "Excellent"
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Rating",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "default": 4.8
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "default": "23,252"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 32,
      "step": 4,
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 32,
      "step": 4,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Trustpilot Inline Badge (SVG)"
    }
  ]
}
{% endschema %}