    "text_with_icons_AkgtqK": {
      "type": "text-with-icons",
      "blocks": {
        "text_block_nXtxYR": {
          "type": "text_block",
          "settings": {
            "icon": "plant",
            "title": "",
            "text": "<p>We research every brand and product before we sell it, to ensure they are one’s families can trust.</p>"
          }
        },
        "text_block_ew8FUL": {
          "type": "text_block",
          "settings": {
            "icon": "phone",
            "title": "",
            "text": "<p>We are proud of our expert customer service team who are always on hand to help answer any questions and offer their expert advice.</p>"
          }
        },
        "text_block_KWYqt8": {
          "type": "text_block",
          "settings": {
            "icon": "envelope",
            "title": "",
            "text": "<p>We want you to be able to shop with us with confidence so we offer a seamless and hassle-free 60-days returns process.</p>"
          }
        },
        "text_block_qcm3qd": {
          "type": "text_block",
          "settings": {
            "icon": "calendar",
            "title": "",
            "text": "<p>For extra peace of mind we offer our standard warranty on all our products against fault and breakage.</p>"
          }
        },
        "text_block_EYpCxG": {
          "type": "text_block",
          "settings": {
            "icon": "package",
            "title": "",
            "text": "<p>All our packaging is sustainable and recyclable and we use only the essential amount with no space waste inside boxes.</p>"
          }
        },
        "text_block_LyT6cL": {
          "type": "text_block",
          "settings": {
            "icon": "ribbon",
            "title": "",
            "text": "<p>We're rated 5 stars for our excellent customer service, delivery, aftercare and wide product range.</p>"
          }
        },
        "text_block_XphpGA": {
          "type": "text_block",
          "settings": {
            "icon": "chat",
            "title": "",
            "text": "<p>We ask real parents to do real reviews on our products to ensure they really are best for baby and best for you.</p>"
          }
        },
        "text_block_aPPxW7": {
          "type": "text_block",
          "settings": {
            "icon": "sales-tag",
            "title": "",
            "text": "<p>Earn points with every purchase you make, then turn those points into money off your next purchase.</p>"
          }
        }
      },
